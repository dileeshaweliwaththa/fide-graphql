# ─────────────────────────────────────────────────────────────────────────────
# fide-graphql  —  environment variables
# Copy to .env before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# SSH_TUNNEL_HOST
# ───────────────
# The user@host target for the SSH -D 1080 sidecar tunnel.
# Must be a non-Azure server whose IP is not blocked by FIDE.
SSH_TUNNEL_HOST=root@194.76.27.9

# SSH_TUNNEL_PASS
# ───────────────
# Password for the SSH user on SSH_TUNNEL_HOST.
# Used by sshpass inside the tunnel sidecar — no key file needed.
SSH_TUNNEL_PASS=your-password-here

# FIDE_PROXY_URLS
# ───────────────
# Comma-separated list of proxy candidates tried IN ORDER at startup.
# ProxyManagerService probes each one, activates the first that works,
# and automatically rotates to the next on network failure.
#
# Supported formats:
#   direct                      no proxy (direct connection)
#   socks5://host:port          SOCKS5 (use with the ssh-tunnel sidecar)
#   socks4://host:port          SOCKS4
#   http://host:port            HTTP CONNECT proxy
#   https://host:port           HTTPS CONNECT proxy
#
# Inside Docker the ssh-tunnel sidecar is reachable as "ssh-tunnel".
# Example — try direct first, fall back to tunnel:
FIDE_PROXY_URLS=direct,socks5://ssh-tunnel:1080
#
# If direct is ALWAYS blocked (Azure), skip it for a faster startup:
# FIDE_PROXY_URLS=socks5://ssh-tunnel:1080
